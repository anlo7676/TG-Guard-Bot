# Copy to .env; Docker Compose loads it. Local execution reads environment variables.
BOT_TOKEN=
BOT_MODE=polling
BOT_SUPER_ADMINS=
HTTP_ADDR=:8080
MYSQL_DSN=tgguard:change-me@tcp(127.0.0.1:3306)/tgguard?parseTime=true&charset=utf8mb4&loc=UTC
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
REDIS_ADDR=127.0.0.1:6379
# Dedicated Redis logical database (0-15); do not share between bots.
REDIS_DB=0
REDIS_PASSWORD=change-redis-password
# At least 32 random characters, required for management API.
ADMIN_API_TOKEN=
# Optional independent encryption secret (32+ random characters). Keep it stable and back it up.
# If omitted, ADMIN_API_TOKEN is used as the encryption master; rotating it would require migrating encrypted settings.
SETTINGS_ENCRYPTION_KEY=
# Required only for webhook mode. Use an HTTPS URL ending in /telegram/webhook.
WEBHOOK_URL=
WEBHOOK_SECRET=
WORKERS=8
# Redact old processed message bodies and delete AI usage details after this many days.
# Punishment counters, feedback evidence and unfinished work are retained. 0 disables cleanup.
RETENTION_DAYS=90
# Empty key disables provider; each group must also enable ai_enabled.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_ALLOW_INSECURE_HTTP=false
AI_MODEL=
AI_TIMEOUT=12s
AI_CONCURRENCY=4

# Docker web access: 127.0.0.1 for local access, 0.0.0.0 for server IP access.
PANEL_BIND=127.0.0.1
# Optional public IP or domain shown by the Linux deployment script.
PANEL_HOST=
# Optional HTTPS reverse proxy domain (compose.https.yaml).
PANEL_DOMAIN=
# Only trust controlled reverse proxies. Empty means ignore forwarded client IPs.
TRUSTED_PROXY_CIDRS=
